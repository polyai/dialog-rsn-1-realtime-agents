# Your Dialog-RSN-1 API key, from studio.poly.ai (API Keys).
POLY_API_KEY=

# Optional: Cartesia for natural-sounding voices. Without it, the page uses the browser's own voice.
CARTESIA_API_KEY=

# Optional overrides
# DIALOG_REALTIME_URL=wss://api.studio.poly.ai/v1/realtime
# PORT=3000
# Behind a proxy, the host names the page is served under (default: localhost,127.0.0.1,[::1])
# ALLOWED_HOSTS=agents.example.com
